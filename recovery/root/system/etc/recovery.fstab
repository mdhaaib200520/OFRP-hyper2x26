#<src>                                  <mnt_point>            <type> <mnt_flags>             <fs_mgr_flags>



system                                  /system                auto   ro                      wait,slotselect,avb=vbmeta_system,logical
vendor                                  /vendor                auto   ro                      wait,slotselect,avb,logical
product                                 /product               auto   ro                      wait,slotselect,avb,logical
system_ext                              /system_ext            auto   ro                      wait,slotselect,avb=vbmeta_system,logical
mi_ext                                  /mi_ext                auto   ro                      wait,slotselect,avb=vbmeta,logical,nofail
vendor_dlkm                             /vendor_dlkm           auto   ro                      wait,slotselect,avb,logical
odm_dlkm                                /odm_dlkm              auto   ro                      wait,slotselect,avb,logical
system_dlkm                             /system_dlkm           auto   ro                      wait,slotselect,avb,logical



/dev/block/by-name/md_udc               /metadata              ext4   noatime,nosuid,nodev,discard    wait,check,formattable



/dev/block/by-name/userdata             /data                  f2fs   noatime,nosuid,nodev,discard,noflush_merge,fsync_mode=nobarrier,reserve_root=134217,resgid=1065,inlinecrypt,gc_merge,atgc    wait,check,formattable,quota,latemount,fileencryption=aes-256-xts:aes-256-cts:v2,keydirectory=/metadata/vold/metadata_encryption



/dev/block/by-name/rescue               /cache                 ext4   noatime,nosuid,nodev,noauto_da_alloc,discard    wait,check,formattable




/devices/platform/11240000.mmc*        auto                   auto   defaults                voldmanaged=sdcard1:auto,encryptable=userdata
/devices/platform/mt_usb*              auto                   vfat   defaults                voldmanaged=usbotg:auto




/dev/block/by-name/frp                  /persistent            emmc   defaults                defaults
/dev/block/by-name/nvram                /nvram                 emmc   defaults                defaults
/dev/block/by-name/proinfo              /proinfo               emmc   defaults                defaults
